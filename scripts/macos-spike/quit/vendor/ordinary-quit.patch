 impl ApplicationDelegate {
+    pub(super) fn intercept_quit(&self, send: impl FnOnce() + 'static) {
+        assert!(matches!(*self.ivars().quit.borrow(), Quit::Disabled));
+        self.ivars().quit.replace(Quit::Armed(Box::new(send)));
+    }
+
+    pub(super) fn finish_quit(&self) {
+        assert!(matches!(*self.ivars().quit.borrow(), Quit::Draining));
+        self.ivars().quit.replace(Quit::AfterHandler);
+        self.schedule_quit();
+    }
+
+    /// Queue the grant on the main GCD queue. The block runs only after winit's handler
+    /// borrow is released; a nested run loop inside a handler defers it to that handler's return.
+    fn schedule_quit(&self) {
+        if !matches!(*self.ivars().quit.borrow(), Quit::AfterHandler) {
+            return;
+        }
+        self.ivars().quit.replace(Quit::Scheduled);
+        dispatch2::DispatchQueue::main().exec_async(|| {
+            let delegate = Self::get(MainThreadMarker::new().expect("main queue"));
+            if delegate.ivars().event_handler.in_use() {
+                eprintln!("quit: handler busy");
+                delegate.ivars().quit.replace(Quit::AfterHandler);
+            } else {
+                delegate.reissue_quit();
+            }
+        });
+    }
+
+    fn reissue_quit(&self) {
+        self.ivars().quit.replace(Quit::Authorized);
+        let mtm = objc2_safe::MainThreadMarker::new().expect("AppKit main thread");
+        app_kit_safe::NSApplication::sharedApplication(mtm).terminate(None);
+    }
